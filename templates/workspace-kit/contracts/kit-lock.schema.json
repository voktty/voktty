{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voktty workspace kit base integrity record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bases"],
  "properties": {
    "schema": { "const": 1 },
    "bases": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "version", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^\\.voktty/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
          },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
